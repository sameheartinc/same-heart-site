# Copy this file to .env.local and fill in real values.
# Get these from your Supabase project: Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase project: Settings -> API -> service_role secret.
# Bypasses Row Level Security entirely -- server-side only, never expose
# this to the browser. Used by every app/api/* route under lib/supabaseAdmin.ts
# and lib/supabaseServer.ts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Get this from console.anthropic.com -> API Keys
# NEVER put this in a NEXT_PUBLIC_ variable -- it must stay server-side only.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Powers the Commons Guide chat widget (app/api/commons-guide/route.ts).
# Get one at aistudio.google.com/apikey. Without it, the Guide shows a
# friendly "not set up yet" message instead of a broken button.
GEMINI_API_KEY=your-gemini-api-key-here

# Verifies that requests to app/api/cron/* actually come from Vercel Cron,
# not an open, unauthenticated endpoint. Set to any long random string,
# and set the same value in Vercel's own Cron secret config.
CRON_SECRET=your-random-cron-secret-here

# Optional second Signal source alongside RSS feeds (see
# app/api/cron/fetch-news/route.ts) -- get a free key at newsapi.org.
# The hourly fetch runs fine without this; it only skips this one source.
NEWSAPI_KEY=your-newsapi-key-here

# The Merch Ship's live product feed and checkout (lib/shopify.ts) --
# get these from Shopify Admin -> Settings -> Apps -> Develop apps ->
# create a Storefront API access token. Without both set, the shop page
# just shows as not configured.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-access-token-here

# Cloudflare Turnstile's site key (lib/turnstile.ts) -- proves a visitor
# is human before sign-up, invisibly unless Cloudflare's risk score calls
# for a challenge. Create a widget at dash.cloudflare.com; the matching
# secret key goes in Supabase Dashboard -> Authentication -> Attack
# Protection, not here. Without this set, sign-up just proceeds without
# a Turnstile token, same as before it existed.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key-here

# Sends the email-gifting flow's real emails (lib/emailServer.ts) -- get
# an API key at resend.com. RESEND_FROM_EMAIL must be an address on a
# domain you've verified in Resend; without it, gifting falls back to
# Resend's own onboarding@resend.dev sender, which only delivers to your
# own Resend account's email.
RESEND_API_KEY=your-resend-api-key-here
RESEND_FROM_EMAIL=Same Heart <gifts@yourdomain.com>
